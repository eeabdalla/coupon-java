meta {
  name: Save coupons batch
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/coupons/batch
  body: json
  auth: inherit
}

body:json {
  {
    "coupons": [
      {
        "code": "SUMMER20",
        "discount": 20.00,
        "description": "Summer sale 20% off",
        "applicationCount": 100
      },
      {
        "code": "WINTER10",
        "discount": 10.00,
        "description": "Winter sale 10% off",
        "applicationCount": 50
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

